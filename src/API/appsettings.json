{
  // ── Secrets are NOT stored here ─────────────────────────────────────────────
  // This file is committed, so anything in it is public to everyone with repo
  // access and lives in git history forever. Four secrets used to sit here in
  // plaintext (the live SMTP password, the seed admin password, the JWT signing
  // key, and an `sa` connection string); they have been removed, and because
  // deleting them does not undo their presence in history they must all be
  // ROTATED. See SECURITY-SECRETS.md for the rotation runbook.
  //
  // Supply them per environment instead, as environment variables (the `__`
  // separator maps to config nesting) or user-secrets in local dev:
  //
  //   ConnectionStrings__DefaultConnection   (use the least-privilege sot_app
  //                                           login from SECURITY-SECRETS.md, not sa)
  //   JwtSettings__SecretKey                 (>= 32 chars)
  //   EmailSettings__Password
  //   Seed__DefaultAdminPassword
  //
  // The app fails fast at boot if any of them is missing, rather than starting
  // with a weak default.

  "PortalUrl": "https://qnfsms025.andritz.com/SOT",

  "App": {
    "PathBase": "/SOT"
  },

  "JwtSettings": {
    "Issuer": "AndritzVendorPortal",
    "Audience": "AndritzVendorPortalClient",
    "ExpiryHours": 8
  },

  "EmailSettings": {
    "Host": "mail.andritz.com",
    "Port": 25,
    "Username": "SCMVendoApprovalNotification",
    // STARTTLS is deliberately OFF: the internal relay does not advertise it on
    // port 25 and enabling it breaks every send (see commit 45cc7eb).
    "EnableSsl": false,
    "FromEmail": "QNFSASCMNotification@andritz.com",
    "FromName": "SCMVendoApprovalNotification",
    // Hard ceiling on one SMTP conversation. Mail is queued and delivered by a
    // background dispatcher, so a slow relay delays mail — it can no longer hold
    // an HTTP request (or a thread-pool thread) open.
    "TimeoutSeconds": 15,
    "OutboxPollSeconds": 5,
    "OutboxBatchSize": 20,
    "OutboxMaxAttempts": 6
  },

  "Swagger": {
    "Enabled": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
