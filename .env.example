# Copy to `.env` (next to docker-compose.yml) and edit to point the dockerized
# API at your host SQL Server. docker compose substitutes these into the
# ConnectionStrings__DefaultConnection value. Defaults shown are what's used
# when no .env is present.
#
# LOCAL ONLY. These never reach production — the office deploy supplies every
# secret through per-app-pool environment variables. See SECURITY-SECRETS.md,
# which also covers rotating the credentials that were committed to
# appsettings.json (all of them must be treated as compromised).

# host.docker.internal = "the Docker host", i.e. your machine running SQL Server.
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=SOT
DB_USER=sa
DB_PASSWORD=LocalDev@1234
