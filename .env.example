# Copy to `.env` (next to docker-compose.yml) and edit to point the dockerized
# API at your host SQL Server. docker compose substitutes these into the
# ConnectionStrings__DefaultConnection value. Defaults shown are what's used
# when no .env is present.

# host.docker.internal = "the Docker host", i.e. your machine running SQL Server.
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=SOT
DB_USER=sa
DB_PASSWORD=Andritz@1234
